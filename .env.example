SNAKECARE_ENVIRONMENT=local
SNAKECARE_LOG_LEVEL=INFO
SNAKECARE_DATABASE_URL=postgresql+asyncpg://snakecare:snakecare@localhost:5432/snakecare
SNAKECARE_REDIS_URL=redis://localhost:6379/0
SNAKECARE_REDIS_ENABLED=false
SNAKECARE_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
SNAKECARE_API_BASE_URL=http://localhost:8000
SNAKECARE_JWT_SECRET=change-me-to-at-least-32-random-characters
SNAKECARE_ACCESS_TOKEN_MINUTES=15
SNAKECARE_REFRESH_TOKEN_DAYS=30
SNAKECARE_FIREBASE_PROJECT_ID=
SNAKECARE_FIREBASE_CREDENTIALS_PATH=
SNAKECARE_GEMINI_ENABLED=false
# Keep this secret in .env only. Never place it in Flutter or source control.
SNAKECARE_GEMINI_API_KEY=
SNAKECARE_GEMINI_MODEL=gemini-3.6-flash
SNAKECARE_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
SNAKECARE_GEMINI_TTS_VOICE=Kore
SNAKECARE_GEMINI_TTS_TIMEOUT_SECONDS=30
SNAKECARE_REVERSE_GEOCODING_ENABLED=true
SNAKECARE_REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
SNAKECARE_REVERSE_GEOCODING_TIMEOUT_SECONDS=4
SNAKECARE_BOOTSTRAP_GOVERNMENT_ADMIN_EMAILS=[]
SNAKECARE_REPORT_STORAGE_PATH=./backend/var/reports
SNAKECARE_SNAKEBITE_PHOTO_STORAGE_PATH=./backend/var/snakebite-photos
SNAKECARE_SNAKEBITE_PHOTO_MAX_UPLOAD_BYTES=8388608
